{
  "manifest_version": 3,
  "name": "Joget Skin (builder + userview)",
  "version": "1.3.7",
  "description": "Declutter tweaks, App Composer layout, optional Indigo theme and a save chime for Joget DX 9 builders and userview pages (toggleable).",
  "icons": {
    "16": "icons/fox-16.png",
    "32": "icons/fox-32.png",
    "48": "icons/fox-48.png",
    "96": "icons/fox-96.png",
    "128": "icons/fox-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "joget-skin@alexwoon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/jw/web/console/*",
    "*://*/jw/web/userview/*",
    "*://*/jw/web/embed/userview/*"
  ],
  "action": {
    "default_title": "Joget Skin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fox-16.png",
      "32": "icons/fox-32.png",
      "48": "icons/fox-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/jw/web/console/*",
        "*://*/jw/web/userview/*",
        "*://*/jw/web/embed/userview/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/jw/web/console/*"
      ],
      "css": [
        "builder.css",
        "themes/indigo/builder.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "css_origin": "author"
    },
    {
      "matches": [
        "*://*/jw/web/userview/*",
        "*://*/jw/web/embed/userview/*"
      ],
      "css": [
        "userview.css",
        "themes/indigo/userview.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "css_origin": "author"
    },
    {
      "matches": [
        "*://*/jw/web/console/app/*/builders*"
      ],
      "js": [
        "composer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/jw/web/console/app/*/builder/*"
      ],
      "js": [
        "chime-sound.js",
        "savechime.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/jw/web/console/app/*/builder*"
      ],
      "js": [
        "hotkeys.js",
        "propcollapse.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
